# Create a PostgreSQL database, then add its connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/frameflow_studio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Create with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
# Hash the shared access code on the server; never use NEXT_PUBLIC_ for this value.
ACCESS_CODE_HASH=replace-with-a-bcrypt-hash
# Optional: change the signed administrator actor from "admin".
ADMIN_EMAIL=admin@example.com

# S3-compatible private bucket (AWS S3, Cloudflare R2, MinIO, etc.).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=frameflow-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Keep image objects private. For local development, MinIO can be used.
S3_FORCE_PATH_STYLE=false
# Optional policy: photos are automatically deleted after this many days (default 30).
PHOTO_RETENTION_DAYS=30
FFMPEG_PATH=ffmpeg
# Required only when an optional caption is rendered into an MP4.
FFMPEG_FONT_FILE=
NODE_ENV=development
